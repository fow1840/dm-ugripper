# Fixed USB names for the observed V3 gripper topology on device 240.
#
# Captured one side at a time on the current device 240 on 2026-08-14:
# - right hand USB2 / USB3: 1-1 / 8-1
# - left hand USB2 / USB3: 5-1 / 6-1
# - USB2 four-port hub: .1=main camera, .2=tactile R,
#   .3=tactile L, .4=CH9344
# - USB3 Fays device: .2

ACTION!="add|change", GOTO="ugripper_fixed_end"

SUBSYSTEM=="usb", GOTO="ugripper_fixed_usb"
SUBSYSTEM=="video4linux", GOTO="ugripper_fixed_video"
SUBSYSTEM=="tty", GOTO="ugripper_fixed_tty"
GOTO="ugripper_fixed_end"

LABEL="ugripper_fixed_usb"
# Fays SDK needs access to the USB device/control node.
ENV{DEVTYPE}=="usb_device", KERNEL=="8-1.2", ATTR{idVendor}=="0403", ATTR{idProduct}=="602e", ATTR{speed}=="5000", MODE:="0777", GROUP:="plugdev"
ENV{DEVTYPE}=="usb_device", KERNEL=="6-1.2", ATTR{idVendor}=="0403", ATTR{idProduct}=="602e", ATTR{speed}=="5000", MODE:="0777", GROUP:="plugdev"
GOTO="ugripper_fixed_end"

LABEL="ugripper_fixed_video"
# Fays interface 00 is stereo; interface 02 is IMU.
KERNEL=="video*", KERNELS=="8-1.2", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="602e", ATTRS{speed}=="5000", ENV{ID_USB_INTERFACE_NUM}=="00", ATTR{index}=="0", MODE:="0777", GROUP:="video", SYMLINK+="stereo_right", SYMLINK+="right_fays_stereo"
KERNEL=="video*", KERNELS=="8-1.2", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="602e", ATTRS{speed}=="5000", ENV{ID_USB_INTERFACE_NUM}=="02", ATTR{index}=="0", MODE:="0777", GROUP:="video", SYMLINK+="right_fays_imu"
KERNEL=="video*", KERNELS=="6-1.2", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="602e", ATTRS{speed}=="5000", ENV{ID_USB_INTERFACE_NUM}=="00", ATTR{index}=="0", MODE:="0777", GROUP:="video", SYMLINK+="stereo_left", SYMLINK+="left_fays_stereo"
KERNEL=="video*", KERNELS=="6-1.2", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="602e", ATTRS{speed}=="5000", ENV{ID_USB_INTERFACE_NUM}=="02", ATTR{index}=="0", MODE:="0777", GROUP:="video", SYMLINK+="left_fays_imu"

# Main cameras on port 1 of each USB2 four-port hub.
KERNEL=="video*", KERNELS=="1-1.1", ATTRS{idVendor}=="27c2", ATTRS{idProduct}=="0530", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="cam_right"
KERNEL=="video*", KERNELS=="5-1.1", ATTRS{idVendor}=="27c2", ATTRS{idProduct}=="0530", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="cam_left"

# Tactile cameras on ports 2 (R) and 3 (L).
KERNEL=="video*", KERNELS=="1-1.2", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="tcam_right_r"
KERNEL=="video*", KERNELS=="1-1.3", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="tcam_right_l"
KERNEL=="video*", KERNELS=="5-1.2", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="tcam_left_r"
KERNEL=="video*", KERNELS=="5-1.3", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="tcam_left_l"
GOTO="ugripper_fixed_end"

LABEL="ugripper_fixed_tty"
# CH9344 is fixed on port 4. The helper maps group rank 1/2 to
# gripper/encoder for the side selected by the exact parent path.
KERNEL=="ttyCH9344USB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d9", MODE:="0666"
KERNEL=="ttyCH9344USB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d9", PROGRAM=="/usr/local/bin/ugripper_ch9344_symlink_name %p %k", SYMLINK+="%c"

LABEL="ugripper_fixed_end"
