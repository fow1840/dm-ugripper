[Unit]
Description=Ugripper Recorder
Wants=umi-shutdown-trigger.path
After=network.target local-fs.target umi-shutdown-trigger.path cftc_users.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/ugripper

Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStartPre=-+/opt/ugripper/.venv/bin/python3 /opt/ugripper/config/uvc_workqueue_affinity.py apply
Environment="UGRIPPER_CPU_PROFILE=fays_split"
ExecStart=/opt/ugripper/.venv/bin/python3 /opt/ugripper/config/cpu_affinity.py -- /bin/bash -lc '/opt/ugripper/run_record.sh'
ExecStopPost=-+/opt/ugripper/.venv/bin/python3 /opt/ugripper/config/uvc_workqueue_affinity.py restore

Restart=always
RestartSec=3
TimeoutStopSec=20s
KillMode=control-group

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
