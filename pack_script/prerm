#!/bin/bash
set -e

SERVICE_NAME="{{APP_NAME}}.service"
TACTILE_STATE_DIR="/var/lib/ugripper/tactile_state"

# 定义所有涉及的服务名称
NETWORK_MONITOR_SERVICE="ugripper-network-monitor.service"
SHUTDOWN_TRIGGER_SERVICE="umi-shutdown-trigger.service"
SHUTDOWN_TRIGGER_PATH="umi-shutdown-trigger.path"
SYSTEM_ACTION_RUNTIME_DIR="/run/ugripper"
NTP_SYNC_SERVICE="ugripper-ntp-sync.service"

stop_service_fast() {
    local service_name="$1"
    local timeout_sec="${2:-5}"

    timeout "${timeout_sec}s" systemctl stop "$service_name" >/dev/null 2>&1 || true

    if systemctl is-active --quiet "$service_name"; then
        echo "Warning: $service_name stop timeout, force killing..."
        systemctl kill "$service_name" >/dev/null 2>&1 || true
    fi
}

force_cleanup_recording_processes() {
    local hmi_patterns=(
        'GripperHmiTool.*--state'
        'gripper_hmi_test.*--state'
    )
    local pattern=""

    if command -v pkill >/dev/null 2>&1; then
        pkill -TERM -f '/opt/ugripper/run_record.sh' >/dev/null 2>&1 || true
        for pattern in "${hmi_patterns[@]}"; do
            pkill -TERM -f "$pattern" >/dev/null 2>&1 || true
        done
        pkill -TERM -f 'audio/audio_play.py' >/dev/null 2>&1 || true
        sleep 0.3
        pkill -KILL -f '/opt/ugripper/run_record.sh' >/dev/null 2>&1 || true
        for pattern in "${hmi_patterns[@]}"; do
            pkill -KILL -f "$pattern" >/dev/null 2>&1 || true
        done
        pkill -KILL -f 'audio/audio_play.py' >/dev/null 2>&1 || true
    fi

    rm -f /dev/shm/ugripper/umi_audio_pipe \
        /dev/shm/ugripper/umi_audio_ready \
        /dev/shm/ugripper/umi_record_control.pipe \
        /dev/shm/ugripper/umi_stereo_camera_control.pipe \
        /dev/shm/ugripper/umi_left_fays_cmd \
        /dev/shm/ugripper/umi_right_fays_cmd \
        /tmp/umi_recording.lock \
        "${SYSTEM_ACTION_RUNTIME_DIR}/system_action_request" \
        "${SYSTEM_ACTION_RUNTIME_DIR}/system_action_result" || true
}

# Wait for a download/recording/USB reset before terminating the runtime.
# The local worker already owns this lock during a Web self-install.
if [ ! -e /run/ugripper-web/self-installing ] && [ -e /run/ugripper/maintenance.lock ]; then
    exec 8<>/run/ugripper/maintenance.lock
    if ! flock -w 60 8; then
        echo "Device busy: recording, download or maintenance has not completed." >&2
        exit 1
    fi
fi
# Stop old HTTP code on every reinstall, but never terminate its in-flight installer.
systemctl stop ugripper-ego-timesync.service || true
systemctl stop ugripper-webserver.service || true
if [ ! -e /run/ugripper-web/self-installing ]; then
    systemctl stop ugripper-maintenance.service || true
fi
if [ "$1" = "remove" ]; then
    systemctl disable ugripper-webserver.service ugripper-maintenance.service || true
fi
echo "Removing {{APP_NAME}} configuration..."

# --------------------------------------------------
# 1) 快速停止服务与残留进程（避免安装后旧进程残留）
# --------------------------------------------------
stop_service_fast "$SERVICE_NAME" 6
stop_service_fast "$NETWORK_MONITOR_SERVICE" 4
stop_service_fast "$NTP_SYNC_SERVICE" 4
force_cleanup_recording_processes

# Restore while package helpers still exist; dpkg removes them before postrm.
if [ "$1" = "remove" ] && [ -f /usr/local/lib/ugripper/logging/ram_logging_config.py ]; then
    /usr/bin/python3 /usr/local/lib/ugripper/logging/ram_logging_config.py uninstall
fi

# --------------------------------------------------
# 2) 禁用服务
# --------------------------------------------------
systemctl disable "$SERVICE_NAME" || true
systemctl disable "$NETWORK_MONITOR_SERVICE" || true
systemctl disable "$NTP_SYNC_SERVICE" || true
systemctl disable ugripper-ego-timesync.service || true
systemctl disable --now "$SHUTDOWN_TRIGGER_PATH" || true
systemctl stop "$SHUTDOWN_TRIGGER_SERVICE" || true
# --------------------------------------------------
# 3) 清理生成的文件
# --------------------------------------------------
echo "Cleaning up systemd units and configs..."

# 升级/重装时清除触觉传感器基线文件，避免旧基线影响新版本延续使用
if [ "$1" = "upgrade" ]; then
    rm -rf "$TACTILE_STATE_DIR" || true
fi


systemctl daemon-reload

# --------------------------------------------------
# 6) udev reload
# --------------------------------------------------
udevadm control --reload-rules || true

echo "{{APP_NAME}} cleanup finished."
exit 0
