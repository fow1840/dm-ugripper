#!/bin/sh
set -eu

tool_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
python_bin=${TACTILE_DAMAGE_PYTHON:-/usr/bin/python3}
if [ ! -x "$python_bin" ]; then
    python_bin=$(command -v python3)
fi

if [ -n "${LD_LIBRARY_PATH:-}" ]; then
    exec env -u LD_LIBRARY_PATH "$python_bin" "$tool_dir/tactile_damage_detector.py" "$@"
fi
exec "$python_bin" "$tool_dir/tactile_damage_detector.py" "$@"
